NEXT_PUBLIC_APP_NAME="PRISM CURRENT"
NEXT_PUBLIC_APP_TAGLINE="Understand what matters."
# Optional: enables LLM-grade summarization in the AI pipeline. Leave empty to run
# in heuristic mode (deterministic extractive summarizer — still fully functional).
# Any OpenAI-compatible endpoint works.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Comma-separated list of IPs allowed to view /admin (defaults to loopback only)
ADMIN_ALLOWED_IPS=127.0.0.1,::1,::ffff:127.0.0.1
# Secret used to authorize POST /api/cron (required in production)
CRON_SECRET=
# Set to "1" to let the dashboard trigger a live ingestion attempt on cold start
ALLOW_LIVE_INGESTION_ON_START=0
